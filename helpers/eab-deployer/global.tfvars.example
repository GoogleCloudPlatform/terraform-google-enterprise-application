// =============================================================================
// GLOBAL SINGLE PROJECT / STANDALONE EXAMPLE DEPLOYMENT VARIABLES
// =============================================================================

// Helper Tool Configurations (Required by the eab-deployer CLI)

// The directory where the user has created a fresh git clone of the Enterprise Application Blueprint repository
eab_code_path = "FULL_PATH_TO_FOLDER_WHERE_THE_EAB_CODE_WAS_CHECKED_OUT"

// The directory where the helper will copy files and run commands
code_checkout_path = "FULL_PATH_TO_FOLDER_WHERE_TO_CHECK_OUT_THE_SOURCE_REPOSITORIES"


// Standalone Example Configurations

project_id                         = "YOUR_EXISTING_PROJECT_ID" // Google Cloud project ID in which to deploy all example resources
region                             = "us-central1" // Google Cloud region for deployments
network_id                         = "https://www.googleapis.com/compute/v1/projects/YOUR_EXISTING_PROJECT_ID/global/networks/YOUR_VPC_NAME" // Network ID/self link (or workerpool_network_id)
subnetwork_self_link               = "https://www.googleapis.com/compute/v1/projects/YOUR_EXISTING_PROJECT_ID/regions/us-central1/subnetworks/YOUR_SUBNETWORK_NAME" // Subnetwork self-link
workerpool_id                      = "projects/YOUR_EXISTING_PROJECT_ID/locations/us-central1/workerPools/YOUR_POOL_NAME" // Cloud Build Worker Pool ID to use
logging_bucket                     = null // Optional logging bucket
bucket_kms_key                     = null // Optional KMS Key ID

// Optional Network Configurations (Only applicable to certain examples like default-example, llm-model, agent)
// create_nat                         = true // Optional: Enables Cloud NAT creation for Private Worker Pool
// enables_network_connection_and_peering_routes = true // Optional: Enables Network connection and peering routes

// VPC Service Controls (Optional)
service_perimeter_name             = null // Service perimeter name (e.g. accessPolicies/.../servicePerimeters/...)
service_perimeter_mode             = "DRY_RUN" // Service perimeter mode: ENFORCE, DRY_RUN
access_level_name                  = null // Access Level full name

// Binary Authorization & Attestation
attestation_kms_key                = "projects/YOUR_EXISTING_PROJECT_ID/locations/us-central1/keyRings/YOUR_KEYRING/cryptoKeys/YOUR_KEY_NAME" // The KMS Key ID to be used by attestor
binary_authorization_image         = "us-central1-docker.pkg.dev/YOUR_EXISTING_PROJECT_ID/YOUR_REPO/YOUR_IMAGE" // The Binary Authorization image to be used to create attestation
binary_authorization_repository_id = "projects/YOUR_EXISTING_PROJECT_ID/locations/us-central1/repositories/YOUR_REPOSITORY_NAME" // The Artifact Registry location with format projects/{{project}}/locations/{{location}}/repositories/{{repository_id}}

// Namespace/Teams (For namespace/group email configuration)
teams = {
  "namespace" = "your-group@yourdomain.com"
}

// Integration of repositories with Cloud Build v2
cloudbuildv2_repository_config = {
  github_app_id_secret_id                     = null
  github_secret_id                            = null
  gitlab_authorizer_credential_secret_id      = null
  gitlab_enterprise_ca_certificate            = null
  gitlab_enterprise_host_uri                  = null
  gitlab_enterprise_service_directory         = null
  gitlab_read_authorizer_credential_secret_id = null
  gitlab_webhook_secret_id                    = null
  repo_type                                   = "CSR"
  repositories = {
    "hello-world" = {
      repository_name = "hello-world-admin"
      repository_url  = ""
    }
  }
  secret_project_id = null
}
