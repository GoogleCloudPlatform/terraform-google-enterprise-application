// =============================================================================
// HARNESS PREREQUISITE CONFIGURATION (FOR SINGLE-PROJECT EXAMPLES)
// =============================================================================

org_id          = "123456789012"             // Google Cloud Organization ID
folder_id       = "123456789012"             // Parent Folder ID where the seed folder/project will be created
billing_account = "XXXXXX-YYYYYY-ZZZZZZ"     // Google Cloud Billing Account ID

// Optional: Cloud Build Service Account email. If empty, the project default Cloud Build SA is used.
cloud_build_sa = ""

// Google Cloud region for KMS, Logging bucket, and Worker Pool resources
region = "us-central1"

// Set to true if you want this harness to pre-provision a dedicated Cloud Build Private Worker Pool with NAT VM.
// If false (default), the single-project example will provision its own worker pool and VPC network via standalone-harness.
create_workerpool = false

// Private Worker Pool network parameters (only used when create_workerpool = true)
workerpool_machine_type    = "e2-standard-4"
workerpool_peering_address = "10.3.3.0"
workerpool_nat_subnet_ip   = "10.1.1.0/24"

// Sandbox and Teardown protection flags (configured for easy teardown in test/demo environments)
project_deletion_policy      = "DELETE" // Options: "DELETE" or "PREVENT"
tfstate_bucket_force_destroy = true     // Allows deleting state bucket containing objects during destroy
kms_prevent_destroy          = false    // Set to false to allow destroying KMS keyrings/keys in test environments
encrypt_gcs_bucket_tfstate   = false    // Set to true to encrypt the remote state bucket with CMEK
